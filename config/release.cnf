### Ansible managed

[mysqld]
server-id=1  # SAME on each master
innodb_autoinc_lock_mode=2
pxc_strict_mode=ENFORCING
wsrep_provider=/opt/local/lib/mysql/plugin/libgalera_smm.so
wsrep_sst_method=xtrabackup-v2

wsrep_sst_auth="sstuser:x0x0x0passwordx0x0x0"

wsrep_cluster_address=gcomm://10.1.95.138,10.1.95.139,10.1.95.140
wsrep_cluster_name=percona-pxc-57-preprod0-dev0
wsrep_node_name=plgda3lvmdev0perconaprod0pxc57node1
wsrep_node_address=10.1.95.139

wsrep_provider_options="gcache.size=4G;gcache.page_size=256M;gcache.keep_pages_count=3;gcache.keep_pages_size=1G;evs.suspect_timeout=PT8S;evs.inactive_timeout=PT25S;gcache.recover=yes"


##user = mysql
##port = 3306
##basedir = /opt/local
#datadir = /var/mysql
#socket = /tmp/mysql.sock
#bind-address = 10.0.100.62
default-storage-engine = innodb
character-set-server = utf8
skip-external-locking
#skip_name_resolve

sql_mode="NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_AUTO_CREATE_USER,NO_ENGINE_SUBSTITUTION"

#open_files_limit = 16384
open_files_limit = 10240
table_open_cache = 8192
table_definition_cache = 1400
key_buffer_size = 1610612736
query_cache_size = 536870912

skip-external-locking
net_write_timeout = 300

sort_buffer_size = 1M
read_buffer_size = 1M
read_rnd_buffer_size = 4M
myisam_sort_buffer_size = 64M

#innodb_data_home_dir = /var/mysql
#innodb_log_group_home_dir = /var/mysql

## additonal settings for ssd and recordsize performance
datadir = /ssd/datadir
innodb_data_file_path   = /ssd/innodb_data_file_path
tmpdir  = /ssd/tmpdir
innodb_data_home_dir    = /ssd/innodb_data_home_dir
innodb_log_group_home_dir       = /var/log/mysql/innodb_log_group_home_dir
#
innodb_data_file_path = ibdata1:100M:autoextend
innodb_buffer_pool_instances = 6
innodb_buffer_pool_size = 12500M
innodb_log_file_size = 200M
innodb_log_buffer_size = 24M
innodb_flush_log_at_trx_commit = 1
innodb_lock_wait_timeout = 50
innodb_file_per_table
innodb_doublewrite = 0
#innodb_io_capacity = 15000
innodb_io_capacity = 2500
innodb_read_io_threads = 8
innodb_write_io_threads = 8

innodb_io_capacity_max = 4000
innodb_lru_scan_depth = 4096
innodb_max_dirty_pages_pct = 75
# Adaptive flushing helps balance dirty page flushing
innodb_adaptive_flushing = ON
innodb_flush_neighbors = 0

slow_query_log_file = /var/log/mysql/slowquery.log
slow_query_log = 1
log_slow_filter = "full_scan,tmp_table_on_disk,filesort_on_disk"
log_slow_verbosity = "full"

thread_cache_size = 1000
query_cache_type = 0
back_log = 64
#tmpdir = /var/tmp
max_connections = 251
max_allowed_packet = 64M
max_join_size = 18446744073709551615
net_buffer_length = 16K
thread_stack = 256K
tmp_table_size = 64M
max_heap_table_size = 64M
wait_timeout= 86400

innodb_log_write_ahead_size=16384
innodb_checksum_algorithm=none
innodb_use_native_aio=0
innodb_flush_method = fsync

### external slave replication settings
##log_bin = /var/log/mysql/bin.log
binlog_format=ROW
##log-error = /var/log/mysql/error.log
expire_logs_days = 7
slave_net_timeout = 3600
gtid_mode=ON
enforce_gtid_consistency=ON
log_slave_updates=ON
# Ensure binlogs work for replication
log_bin_trust_function_creators=1
### /external slave replication settings
